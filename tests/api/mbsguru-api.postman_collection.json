            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"E2E Contact Test\",\n  \"email\": \"e2e-contact@e2e-factory.test\",\n  \"subject\": \"Test message\",\n  \"message\": \"Newman contract test\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/contact-us", "host": ["{{base_url}}"], "path": ["api", "contact-us"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('contact-us reachable + no 5xx', () => pm.expect(pm.response.code).to.be.below(500));"
            ]}
          }]
        },
        {
          "name": "POST /api/contact-us — empty body → 422",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{base_url}}/api/contact-us", "host": ["{{base_url}}"], "path": ["api", "contact-us"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('empty contact body rejected', () => pm.expect(pm.response.code).to.be.oneOf([400, 422]));"
            ]}
          }]
        }
      ]
    },
