{
  "info": {
    "name": "MBSGuru API Contract",
    "description": "Newman-runnable contract tests for the public + authenticated mobile API surface (/api/*). Each request asserts: (1) expected HTTP status, (2) Content-Type is application/json, (3) response body shape via JSON Schema where applicable. Run via `newman run tests/api/mbsguru-api.postman_collection.json -e tests/api/ci.postman_environment.json`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{auth_token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost/mbsguru1/public" },
    { "key": "auth_token", "value": "" }
  ],
  "item": [
    {
      "name": "── PUBLIC TAXONOMY ──",
      "item": [
        {
          "name": "GET /api/countries",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/countries", "host": ["{{base_url}}"], "path": ["api", "countries"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('content-type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('body has data array', () => pm.expect(body).to.have.property('data').that.is.an('array'));",
              "pm.test('each country has id + name', () => {",
              "  if (body.data.length > 0) {",
              "    pm.expect(body.data[0]).to.have.property('id');",
              "    pm.expect(body.data[0]).to.have.property('name');",
              "  }",
              "});"
            ]}
          }]
        },
        {
          "name": "GET /api/course-main-categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/course-main-categories", "host": ["{{base_url}}"], "path": ["api", "course-main-categories"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('has data', () => pm.expect(body).to.have.property('data'));"
            ]}
          }]
        },
        {
          "name": "GET /api/currency-list",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/currency-list", "host": ["{{base_url}}"], "path": ["api", "currency-list"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
            ]}
          }]
        },
        {
          "name": "GET /api/course-languages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/course-languages", "host": ["{{base_url}}"], "path": ["api", "course-languages"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
            ]}
          }]
        },
        {
          "name": "GET /api/course-levels",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/course-levels", "host": ["{{base_url}}"], "path": ["api", "course-levels"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]}
          }]
        }
      ]
    },
    {
      "name": "── AUTH ──",
      "item": [
        {
          "name": "POST /api/login — captures token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{e2e_student_email}}\",\n  \"password\": \"{{e2e_student_password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('login responds 200 or 401', () => pm.expect([200, 401, 422]).to.include(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  if (body.token) { pm.collectionVariables.set('auth_token', body.token); }",
              "}"
            ]}
          }]
        },
        {
          "name": "POST /api/login — invalid creds → 4xx (not 5xx)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"invalid@example.test\",\n  \"password\": \"wrong\"\n}" },
            "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('invalid login returns 4xx', () => {",
              "  pm.expect(pm.response.code).to.be.below(500);",
              "  pm.expect(pm.response.code).to.be.at.least(400);",
              "});",
              "pm.test('JSON error response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
            ]}
          }]
        },
        {
          "name": "POST /api/login — empty body → 422",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('empty login body is rejected', () => pm.expect(pm.response.code).to.be.oneOf([400, 422]));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
            ]}
          }]
        },
        {
          "name": "POST /api/register — empty body → 422",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": { "raw": "{{base_url}}/api/register", "host": ["{{base_url}}"], "path": ["api", "register"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('empty register body rejected', () => pm.expect(pm.response.code).to.be.oneOf([400, 422]));",
              "pm.test('JSON response', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
            ]}
          }]
        }
      ]
    },
    {
      "name": "── COURSE PUBLIC ──",
      "item": [
        {
          "name": "GET /api/course/{bogus-slug} → 404",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/course/this-slug-does-not-exist-zzz", "host": ["{{base_url}}"], "path": ["api", "course", "this-slug-does-not-exist-zzz"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('404 for missing course', () => pm.expect(pm.response.code).to.equal(404));",
              "pm.test('JSON 404 (not HTML)', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));"
            ]}
          }]
        },
        {
          "name": "GET /api/course/buy/{slug}/quote (no-auth) → 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/course/buy/any-slug/quote", "host": ["{{base_url}}"], "path": ["api", "course", "buy", "any-slug", "quote"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('quote requires auth', () => pm.expect(pm.response.code).to.be.oneOf([401, 403]));"
            ]}
          }]
        }
      ]
    },
    {
