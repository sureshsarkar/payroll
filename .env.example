APP_NAME=Laravel
# Safe-by-default for cp .env.example .env on a prod deploy:
#   APP_ENV=production + APP_DEBUG=false → no stack-trace leaks, no
#   Whoops error pages exposing DB queries with credentials. Local
#   dev sets APP_ENV=local + APP_DEBUG=true manually.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_MODE=LIVE #LIVE or DEMO

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# warning is the right prod default — debug fills disk fast under load.
LOG_LEVEL=warning

# P1-4 (2026-05-29) — Content Security Policy.
#   CSP_ENFORCE=false  → Content-Security-Policy-Report-Only header (default).
#                       Browsers report violations but DO NOT block resources.
#                       Safe to ship. Run for 1–2 weeks, audit the report
#                       stream, fix legitimate violations, then flip to true.
#   CSP_ENFORCE=true   → Content-Security-Policy header (enforcing).
#                       Browsers BLOCK violating resources. Only flip after
#                       the report stream has been clean for a full release
#                       cycle.
#   CSP_REPORT_URI     → Optional URL to receive violation reports. Leave
#                       blank to skip (default). Point to a Sentry, Report
#                       URI, or homegrown collector if you want one.
CSP_ENFORCE=false
CSP_REPORT_URI=

# 2026-05-29 — UI/UX audit P0-2: dev tooling MUST be disabled in
# production. Telescope's `enabled` config default in config/telescope.php
# is `true`, so a fresh prod deploy with a default .env would expose
# the /telescope dashboard to any authenticated admin — including its
# stored request bodies, query traces, and bearer tokens.
#
# Set TELESCOPE_ENABLED=false on prod and staging. Only flip to true
# on a hardened operator-only environment + when actively debugging.
#
# Debugbar is also covered: its `enabled` default tracks APP_DEBUG.
# We keep APP_DEBUG=false in prod (the line at the top of this file),
# so Debugbar is off by construction. Defense-in-depth: set
# DEBUGBAR_ENABLED=false explicitly so a misconfigured APP_DEBUG=true
# doesn't surface it.
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mbs
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
# Sessions 1-6 audit baseline switched both to `database`. Requires `sessions`
# and `cache` tables (Laravel-published migrations, run automatically).
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# SECURITY — distinct cookie name prevents collision with other Laravel
# installs on the same host. Override per environment if needed.
SESSION_COOKIE=mbsguru_v1_session

# ── CORS (audit 2026-05-22) ────────────────────────────────────────────
# PRODUCTION SETTINGS. Replace with your real platform + white-label hosts.
# `CORS_ALLOWED_ORIGINS` is comma-separated; the `_REGEX` field is wrapped
# in `#` delimiters to avoid backslash-escape pain in .env parsing and
# covers every coach white-label subdomain in one rule.
CORS_ALLOWED_ORIGINS=https://mbsguru.com,https://www.mbsguru.com
CORS_ALLOWED_ORIGINS_REGEX=#^https://[a-z0-9-]+\.mbsguru\.com$#
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Requested-With,X-CSRF-TOKEN
# CORS_MAX_AGE=86400  # uncomment to cache CORS preflight for 24h

# ── BATCH CAPACITY ENFORCEMENT (audit 2026-05-22) ──────────────────────
# Set to 1 to HARD-BLOCK enrollments that would put a batch over its
# declared capacity. Default 0 = warn-mode (logs `batch-capacity-breach`
# entries but allows the enrollment).
# Recommended rollout: run with =0 for 1-2 weeks, grep the logs for
# breaches, alert affected coaches, then flip to =1.
BATCH_CAPACITY_ENFORCE=0

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# === Web Push (browser push notifications, added 2026-05-18) ===
# Generated by: php artisan webpush:vapid
# Used by the NewBatchAnnouncement (and other InAppNotification) WebPush channel.
# Without these set the WebPush channel is silently skipped.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@example.com"

# === Payment gateway webhooks (added 2026-05-05) ===
# Each gateway dashboard issues a webhook signing secret/id. Until you set
# them here, the corresponding /webhooks/* endpoint fails closed (HTTP 500
# with a logged warning). See docs/PAYMENT_WEBHOOKS_SETUP.md.
STRIPE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYPAL_WEBHOOK_ID=
MP_ACCESS_TOKEN=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# === Spatie Backup (set both before going live) ===
# Encrypts the backup zip with AES-256. Without it, anyone with read
# access to the backup destination disk gets a fully-cleartext
# database dump + uploaded files. Generate with: openssl rand -base64 32
BACKUP_ARCHIVE_PASSWORD=
# Where Spatie\Backup sends success/failure/missing notifications.
# Falls back to MAIL_FROM_ADDRESS if unset; set explicitly so ops is
# not the same address customer emails come from.
BACKUP_NOTIFY_EMAIL=

# === DB binary path (used by spatie/laravel-backup) ===
# DB_DUMP_BINARY_PATH=/usr/bin       # Linux production
# DB_DUMP_BINARY_PATH=C:\xampp\mysql\bin   # Windows local

# === YouTube Data API v3 — platform fallback key (added 2026-05-26) ===
# When a coach hasn't added their own key in /instructor/youtube-credentials,
# YouTubeFetcher falls back to this one. Lets any coach drop a channel ID
# into the YouTube / Recorded Courses sections and have videos render
# without registering their own Google Cloud project. Coach-specific keys
# always win (so heavy users can isolate their own quota).
#
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable: "YouTube Data API v3" on the project before creating the key.
# Default quota: 10,000 units/day; each search.list call = 100 units.
# With the 24h cache in YouTubeFetcher this serves ~100 distinct channels/day.
YOUTUBE_API_KEY=
