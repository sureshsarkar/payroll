# === Telescope tuning (added 2026-05-05 perf pass) ===
# The noisy watchers fire on every cache hit / DB query / view render —
# inserting thousands of telescope_entries rows per page load and ballooning
# the table to hundreds of thousands of rows in a single hour of browsing.
# Useful watchers (Exception, Job, Mail, Notification, Log, Request) stay on.
# Toggle these back to true on demand when you need that level of detail.
TELESCOPE_CACHE_WATCHER=false
TELESCOPE_QUERY_WATCHER=false
TELESCOPE_VIEW_WATCHER=false
TELESCOPE_MODEL_WATCHER=false
TELESCOPE_EVENT_WATCHER=false
TELESCOPE_GATE_WATCHER=false
TELESCOPE_REDIS_WATCHER=false
TELESCOPE_ENABLED=false