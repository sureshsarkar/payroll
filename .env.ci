# CI-only environment template.
#
# Copied to `.env` by .github/workflows/e2e.yml before the suite runs.
# Differs from .env.example in:
#   - APP_ENV=testing (turns on test-suite-specific bindings)
#   - SESSION_SECURE_COOKIE=false (CI runs over plain http)
#   - MAIL_MAILER=array (don't send real mail in CI)
#   - QUEUE_CONNECTION=sync (don't background jobs in CI)
#   - CACHE_DRIVER=array (no DB writes for cache lookups)
#   - Stripe/Razorpay/etc keys blanked (sandbox keys come from CI secrets)
#
# Do NOT commit real secrets here. CI injects them via GitHub Actions
# secrets at the workflow level.

APP_NAME=MBSGuru
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_MODE=LIVE

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mbs_ci
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=ci@mbsguru.test
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# P1-3 — keep logs short in CI
LOG_DAYS=3

# P1-4 — CSP stays Report-Only in CI so we can inspect the header
# stamp without blocking any vendor scripts our E2E hits.
CSP_ENFORCE=false
CSP_REPORT_URI=

# UI/UX audit P0-2 — dev tooling off in CI. No value in recording
# test traffic to Telescope; Debugbar bytes would slow the suite.
TELESCOPE_ENABLED=false
DEBUGBAR_ENABLED=false
